# Large binary data — hosted on Baidu Netdisk, NOT in this repository.
# (GitHub rejects files > 100 MB; Dataset is ~74 GB, Raw_Experimental_Data 20.9 GB.)
# Links and access codes are in README.md.
Dataset/
Raw_Experimental_Data/
Data_and_Code_Availability/

# Common large binary artifacts, in case any are copied in by mistake
*.mat
*.pth
*.h5
*.npz

# Manuscript sources are NOT part of this repository — the paper is under
# submission and its sources live outside the repo. Ignored so that a stray copy
# inside the working tree can never be committed by `git add -A`. Note this is
# deliberately narrow: figure PDFs produced by Validation_Scripts/ are tracked,
# so a blanket *.pdf rule would be misleading here.
*.tex
OE_submission*
els-cas-templates/

# LaTeX / build leftovers
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.bak

# OS / editor cruft
.DS_Store
Thumbs.db
__pycache__/
*.pyc
